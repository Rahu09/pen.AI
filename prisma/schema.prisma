// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7: the client is generated into the source tree (git-ignored) as
// CommonJS, and talks to Postgres through the `pg` driver (src/db/index.ts).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Connection strings live in prisma.config.ts (CLI) and src/db/index.ts (app).
datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @unique
  email String @unique

  File    File[]
  Message Message[]

  stripeCustomerId       String? @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String? @unique @map(name: "stripe_subscription_id")
  stripePriceId          String? @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd String? @map(name: "stripe_current_period_end")
}

enum UploadStatus {
  PENDING
  PROCESSING
  FAILED
  SUCCESS
}

// Why a file ended up FAILED, so the app can tell the user what to do.
enum UploadFailure {
  TOO_MANY_PAGES // more pages than the plan allows
  NO_TEXT // no selectable text, e.g. a scanned PDF
  PROCESSING_ERROR // download, embedding or database step failed
}

model File {
  id   String @id @default(cuid())
  name String

  uploadStatus  UploadStatus   @default(PENDING)
  // Set only when uploadStatus is FAILED.
  failureReason UploadFailure?
  // Number of pages in the PDF, once it has been read.
  pageCount     Int?

  url      String
  key      String
  messages Message[]
  chunks   DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([userId])
}

model Message {
  id   String @id @default(cuid())
  text String @db.Text()

  isUserMessage Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  File      File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId    String?

  @@index([fileId])
  @@index([userId])
}

// One piece of a PDF page, with its embedding. Retrieval for the chat searches
// these rows. Deleting a File deletes its chunks (onDelete: Cascade).
model DocumentChunk {
  id         String @id @default(cuid())
  content    String @db.Text()
  pageNumber Int

  // pgvector column. Prisma has no native vector type, so it is declared as
  // Unsupported and is read and written through LangChain's PrismaVectorStore
  // (raw SQL underneath). It must be optional: Prisma creates the row first,
  // then the store fills in the embedding. 1536 must match EMBEDDING_DIMENSIONS
  // in src/config/ai.ts.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  File      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId    String

  @@index([fileId])
}
