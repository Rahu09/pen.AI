# Copy to .env and fill in. Never commit .env.

# Kinde auth (https://kinde.com)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# PostgreSQL on Neon. Needs the pgvector extension (the migration enables it).
# DATABASE_URL: the pooled connection string (host contains "-pooler"), used by the app.
# DIRECT_URL: the direct connection string, used by `prisma migrate`.
# Note: Neon's own "Env file" names these the other way round.
DATABASE_URL=
DIRECT_URL=

# UploadThing (https://uploadthing.com)
# One token from the dashboard's API Keys page (UploadThing 7 replaced the
# old UPLOADTHING_SECRET and UPLOADTHING_APP_ID).
UPLOADTHING_TOKEN=

# Google Gemini API key (embeddings and chat). Free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Stripe (use test-mode keys locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
